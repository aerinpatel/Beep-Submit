# Database connection string (PostgreSQL with pg_trgm enabled)
DATABASE_URL="postgresql://postgres:password@localhost:5432/beep_jobs"

# Groq LLM API Key (used with openai/gpt-oss-20b or llama models)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Secret token for triggering manual ingestion cron route: /api/cron/ingest
CRON_SECRET="your_secure_cron_secret_token"
